# Copy this file to `.env` and fill in your key. `.env` is gitignored —
# never paste your key into chat or commit it.
#
# Note: inside pi you can skip this file entirely — run `/login openrouter`
# and the guard (plus `npm run live` / `npm run matrix`) will use pi's saved
# auth from ~/.pi/agent/auth.json — either sign-in option works. Note that a
# saved pi login takes precedence over the keys set here.
#
# Usage:
#   1. Copy:  cp .env.example .env   (Git Bash / macOS / Linux)
#   2. Edit .env and set your key below (from https://openrouter.ai/keys)
#   3. Run the live probe:  npm run live
#
# The test scripts read `.env` via `node --env-file-if-exists=.env`, so the
# key never appears in shell history or transcripts, and the scripts still
# run when there is no `.env` at all.

# OpenRouter API key (backend: openrouter, the default).
OPENROUTER_API_KEY=

# TypeSafe API key (backend: typesafe — direct /v1/systemone API).
# TYPESAFE_API_KEY=

# Optional overrides (defaults shown):
# JEV_GUARD_BACKEND=openrouter
# JEV_GUARD_MODEL=~typesafe/jev-latest
# JEV_GUARD_BASE_URL=https://openrouter.ai/api/v1
# JEV_GUARD_TYPESAFE_MODEL=jev-latest
# JEV_GUARD_TYPESAFE_BASE_URL=https://api.typesafe.ai/v1
