{
  "name": "specpi-jev-guard",
  "version": "0.1.0",
  "description": "Pi extension that gates dangerous shell and file tool calls with the Jev classifier via OpenRouter",
  "type": "module",
  "author": "Tanner Middleton",
  "keywords": [
    "pi-package",
    "pi-extension",
    "pi",
    "guardrails",
    "security",
    "openrouter",
    "jev"
  ],
  "license": "MIT",
  "files": [
    "extensions/",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=20"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/TannerMidd/specpi-jev-guard.git"
  },
  "homepage": "https://tannermidd.github.io/specpi-jev-guard/",
  "pi": {
    "extensions": [
      "./extensions/jev-guard.ts"
    ]
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.6.0"
  },
  "scripts": {
    "test": "node --test tests/rules.test.mjs",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm test && npm run typecheck",
    "live": "node --env-file=.env tests/live-jev.mjs",
    "matrix": "node --env-file=.env tests/jev-matrix.mjs",
    "insights": "node tests/jev-insights.mjs",
    "docs:sync": "node tests/docs-sync.mjs",
    "chart:png": "node tests/chart-png.mjs"
  }
}
