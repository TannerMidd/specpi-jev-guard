{
  "name": "specpi-jev-guard",
  "version": "0.3.0",
  "description": "Pi extension that gates dangerous shell and file tool calls with the Jev classifier via OpenRouter",
  "type": "module",
  "author": "Tanner Middleton",
  "keywords": [
    "pi-package",
    "pi-extension",
    "pi",
    "guardrails",
    "security",
    "openrouter",
    "jev"
  ],
  "license": "MIT",
  "files": [
    "extensions/",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/TannerMidd/specpi-jev-guard.git"
  },
  "homepage": "https://tannermidd.github.io/specpi-jev-guard/",
  "pi": {
    "extensions": [
      "./extensions/jev-guard.ts"
    ]
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*"
  },
  "devDependencies": {
    "@gotgenes/pi-permission-system": "^33.0.3",
    "@types/node": "^22.0.0",
    "esbuild": "^0.28.2",
    "typescript": "^5.6.0"
  },
  "scripts": {
    "test": "node --test tests/rules.test.mjs tests/pi-auth.test.mjs tests/audit-display.test.mjs",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm test && npm run typecheck",
    "live": "node --env-file-if-exists=.env tests/live-jev.mjs",
    "matrix": "node --env-file-if-exists=.env tests/jev-matrix.mjs",
    "devious": "node --env-file-if-exists=.env tests/jev-devious.mjs",
    "devious:charts": "node tests/devious-charts.mjs",
    "e2e": "node tests/e2e/run.mjs",
    "e2e:charts": "node tests/e2e-charts.mjs",
    "compare": "node tests/compare-guards.mjs",
    "compare:chart": "node tests/compare-chart.mjs",
    "insights": "node tests/jev-insights.mjs",
    "redteam": "node --env-file-if-exists=.env tests/redteam.mjs",
    "docs:sync": "node tests/docs-sync.mjs",
    "chart:png": "node tests/chart-png.mjs",
    "readme:figures": "node tests/readme-figures.mjs"
  }
}
